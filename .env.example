# Local / Prod 共通: 12-factor に沿って環境変数だけで差分を吸収します。
# ローカルでは `cp .env.example .env` して利用してください（.env はコミットしません）。

# --- App ---
APP_NAME=gcp_cloudsql
ENV=local
LOG_LEVEL=INFO

# Cloud Run などではプラットフォームが PORT を注入します。
# ローカル/compose でも PORT を変えたい場合はここを変更します。
PORT=8000

# --- Database ---
# Local (docker-compose の db サービスへ接続)
DATABASE_URL=postgresql+asyncpg://appuser:apppass@db:5432/appdb

# Prod example (Cloud Run + Cloud SQL Unix socket) - STEP4 以降で詳細化
# asyncpg の unix socket 接続例:
# DATABASE_URL=postgresql+asyncpg://USER:PASSWORD@/DBNAME?host=/cloudsql/INSTANCE_CONNECTION_NAME

# --- SQLAlchemy Engine ---
DB_ECHO=false
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=1800
